{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "generated/**"],
      "env": ["NODE_ENV"]
    },
    "@proppal/schemas#build": {
      "outputs": ["dist/**", "generated/models.ts"]
    },
    "web#build": {
      "cache": false,
      "dependsOn": ["@proppal/schemas#build"]
    },
    "web#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@proppal/schemas#build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },
    "clean": {
      "cache": false
    },
    "type-check": {
      "outputs": []
    }
  }
}
  